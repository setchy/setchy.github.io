---
import "../styles/global.css";
import "../styles/icons.css";
import "@fontsource/newsreader/latin-400.css";
import "@fontsource/newsreader/latin-400-italic.css";
import "@fontsource/newsreader/latin-500.css";
import "@fontsource/newsreader/latin-600.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";

const {
  title = "Hi, I'm Adam",
  description = "Distinguished Engineer, Chief Architect & Technology Advisor — building engineering organizations, open-source tools, and communities that scale.",
} = Astro.props;

// OG image name derives from the page path, matching the open-graph endpoint
// generated by astro-og-canvas (/about/ -> /open-graph/about.png, / -> home)
const ogName =
  Astro.url.pathname === '/'
    ? 'home'
    : Astro.url.pathname.replace(/\/+$/, '').replace(/^\//, '').replace(/\//g, '-') || 'home';
const ogImage = `/open-graph/${ogName}.png`;

const SITE = {
  title: "setchy.io",
  url: "https://setchy.io",
  author: "Adam Setch",
  gaId: "G-1KRZQ6HQZ6",
  cfBeacon: '{"version":"2024.11.0","token":"2f35818ec90b4323a9400a2ff51d952a","r":1}',
};
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        // Suppress theme transitions until first load so the correct theme
        // applies instantly instead of flashing/animating from a light frame.
        var guard = document.createElement('style');
        guard.textContent =
          'html, body, .site-nav, .site-footer { transition: none !important; }';
        document.head.appendChild(guard);
        window.addEventListener('load', function done() {
          window.removeEventListener('load', done);
          setTimeout(function () {
            document.head.removeChild(guard);
          }, 60);
        });
      })();
    </script>

    <title>{title} | {SITE.title}</title>
    <meta name="author" content={SITE.author} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/feed.xml" />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={SITE.url + ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="canonical" href={SITE.url + Astro.url.pathname} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@setchy87" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE.url + ogImage} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1KRZQ6HQZ6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-1KRZQ6HQZ6');
    </script>

    <!-- Cloudflare Analytics -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js/v4513226cdae34746b4dedf0b4dfa099e1781791509496"
      integrity="sha512-ZE9pZaUXND66v380QUtch/5sE9tPFh2zg45pR2PB0CVkCtOREv2AJKkSidISWkysEuQ0EH8faUU5du78bx87UQ=="
      data-cf-beacon={SITE.cfBeacon}
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <slot />
  </body>
</html>
