---
import { socials } from '../data/socials';
---
<ul class="social-links">
  {
    socials.map((s) => (
      <li>
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
          <i class={s.icon} aria-hidden="true"></i>
        </a>
      </li>
    ))
  }
</ul>
