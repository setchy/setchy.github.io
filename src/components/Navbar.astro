---
import { navLinks } from '../data/nav';
---
<nav class="site-nav">
  <div class="container site-nav-inner">
    <a class="brand" href="/" aria-label="Adam Setch — home" title="Home">
      <img class="avatar-nav" src="/avatar.png" alt="" width="36" height="36" decoding="async" />
      <span class="brand-name">Adam&nbsp;Setch</span>
    </a>

    <button class="nav-toggle nav-btn" data-nav-toggle aria-label="Toggle navigation" aria-expanded="false">
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>

    <ul class="nav-links" data-nav-links>
      {navLinks.map((l) => (
        <li>
          <a href={l.href} aria-current={l.href === Astro.url.pathname ? 'page' : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <button class="nav-btn" data-search-toggle aria-label="Search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      </button>
      <button class="nav-btn" data-theme-toggle aria-label="Toggle dark mode">
        <i class="fa-solid fa-moon" data-theme-icon-light aria-hidden="true"></i>
        <i class="fa-solid fa-sun" data-theme-icon-dark aria-hidden="true"></i>
      </button>
    </div>
  </div>
</nav>