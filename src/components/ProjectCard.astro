---
interface Props {
  /** Card destination URL. */
  url: string;
  /** Displayed project name, e.g. "owner/repo". */
  name: string;
  /** One-line project description. */
  description?: string;
  /** Short role label shown in the role chip (e.g. "Maintainer"). */
  roleLabel: string;
  /** Font Awesome icon for the role chip. */
  roleIcon: string;
  /** Pre-formatted star count, e.g. "12.4k". */
  stars: string;
  /** Owner avatar URL; shown in the `full` variant only. */
  ownerAvatar?: string;
  /** Primary language shown in the bottom metadata row (`full` variant). */
  language?: string;
  /** Homepage shown in the bottom metadata row (`full` variant). */
  homepage?: string;
  /** Value for the generic card filter (`data-filter-value`). */
  filterValue?: string;
  /** Filter group id emitted as `data-filter-card` (e.g. "role"). */
  filterCard?: string;
  /** Card style: `full` (OSS grid) or `featured` (homepage list). */
  variant?: 'full' | 'featured';
}

const {
  url,
  name,
  description,
  roleLabel,
  roleIcon,
  stars,
  ownerAvatar,
  language,
  homepage,
  filterValue,
  filterCard,
  variant = 'full',
} = Astro.props;

const filterAttrs =
  filterValue || filterCard
    ? { ...(filterValue ? { 'data-filter-value': filterValue } : {}), ...(filterCard ? { 'data-filter-card': filterCard } : {}) }
    : {};
---
<a class="project-card" href={url} target="_blank" rel="noopener" {...filterAttrs}>
  <div class="project-card-top">
    {variant === 'full' && ownerAvatar && (
      <img
        class="project-owner-avatar"
        src={ownerAvatar}
        alt=""
        loading="lazy"
        referrerpolicy="no-referrer"
        onerror="this.style.display='none'"
      />
    )}
    <span class="project-role" title={roleLabel}>
      <i class={roleIcon} aria-hidden="true"></i>
      {roleLabel}
    </span>
    <span class="project-stars">★ {stars}</span>
  </div>
  <div class="project-name">{name}</div>
  {description && <p class="project-desc">{description}</p>}
  {variant === 'full' && (language || homepage) && (
    <div class="project-card-bottom">
      {language && <span class="project-lang">{language}</span>}
      {homepage && <span class="project-homepage">{homepage}</span>}
    </div>
  )}
</a>