---
import PageLayout from '../layouts/PageLayout.astro';
import skillCategories from '../data/skills.json';

const title = 'About me';
const subtitle = 'Distinguished Engineer // Chief Architect // Senior Executive (VP)';

const interests = [
  { icon: '⚡', title: 'DX', description: 'Developer Experience // Developer Productivity' },
  { icon: '🔭', title: 'Career Pathways', description: 'Building strong engineering communities of practice (guilds, chapters, etc)' },
  { icon: '🔗', title: 'APIs & Integration', description: 'GraphQL // Apollo // REST // AsyncAPI' },
  { icon: '🛡️', title: 'Dependency Management & Technical Health', description: 'LeanIX // Renovate // SBOM' },
  { icon: '💡', title: 'Innovation', description: 'Communicating emerging technology trends via Tech Radars' },
];
---
<PageLayout title={title} description={subtitle} cover="/covers/home.svg">
  <header class="hero" style="background-image: url('/covers/home.svg')">
    <div class="hero-content">
      <h1>{title}</h1>
      {subtitle && <p class="hero-sub">{subtitle}</p>}
    </div>
  </header>

  <main class="main">
    <div class="container">
      <section class="about-intro">
        <img class="about-avatar" src="/avatar.png" alt="Adam Setch" />
        <div class="about-bio">
          <ul class="about-bio-list">
            <li>Distinguished Engineer // Chief Architect // Senior Executive (VP)</li>
            <li>Technology Advisor</li>
            <li>OSS Maintainer and Contributor</li>
          </ul>
        </div>
      </section>

      <section class="about-section">
        <h2>Interests</h2>
        <div class="interests-grid">
          {interests.map((interest) => (
            <div class="interest-card">
              <span class="interest-icon">{interest.icon}</span>
              <div>
                <h3 class="interest-title">{interest.title}</h3>
                <p class="interest-desc">{interest.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="about-section">
        <h2>Skills</h2>
        {skillCategories.map((category) => (
          <div class="skill-category">
            <h3>{category.title}</h3>
            <div class="skill-grid">
              {category.skills.map((skill) => (
                <a class="skill-item" href={skill.url} target="_blank" rel="noreferrer" title={skill.name}>
                  <img src={`https://skills.syvixor.com/api/icons?i=${skill.slug}`} alt={skill.name} width="40" height="40" loading="lazy" />
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>
    </div>
  </main>
</PageLayout>
