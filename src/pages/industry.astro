---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FilterLegend from '../components/FilterLegend.astro';
import LibraryCard from '../components/LibraryCard.astro';
import { industryItems, TYPE_LABELS, type IndustryType } from '../data/industry';
import { sectionIcon } from '../data/section-icons';
import { groupBy } from '../lib/grouping';
import { pageMeta } from '../data/page-meta';

const { title, description } = pageMeta.industry;

const topicOrder = [
  'GraphQL',
  'LaunchDarkly',
  'OWASP Dependency Track',
];

const groups = groupBy(industryItems, (item) => item.topic, topicOrder);

const countForType = (type: IndustryType) => industryItems.filter((item) => item.type === type).length;

const filterOptions = (['web', 'youtube', 'pdf'] as IndustryType[]).map((type) => ({
  value: type,
  label: TYPE_LABELS[type].label,
  icon: TYPE_LABELS[type].icon,
  count: countForType(type),
}));
---
<ContentPageLayout title={title} description={description} subtitle={description} permalink="industry">
  <FilterLegend group="type" options={filterOptions} total={industryItems.length} />

  {
    groups.map((group) => (
      <section class="project-section" data-filter-section="type">
        <SectionHeading title={group.key} icon={sectionIcon(group.key)} />
        <div class="library-grid">
          {group.items.map((item) => (
            <LibraryCard
              url={item.url}
              typeIcon={TYPE_LABELS[item.type].icon}
              title={item.title}
              date={item.date}
              filterValue={item.type}
              filterCard="type"
            />
          ))}
        </div>
      </section>
    ))
  }
</ContentPageLayout>