---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const sections = await getCollection('sections');
  return sections.map((entry) => ({
    params: { slug: entry.data.permalink },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const subtitle = entry.data.subtitle || entry.data.description;
---
<ContentPageLayout
  title={entry.data.title}
  description={entry.data.description}
  subtitle={subtitle}
  permalink={entry.data.permalink}
  mainClass="prose"
  dataPage={entry.data.permalink}
>
  <Content />
</ContentPageLayout>