---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import StatStrip from '../components/StatStrip.astro';
import StatBadge from '../components/StatBadge.astro';
import { travelStats } from '../data/travel';
import { pageMeta } from '../data/page-meta';

const { title, description } = pageMeta.travel;

const headerSubtitle = 'Our holiday travels, on the map and in numbers';
const skratchUrl = 'https://share.skratch.world/N0cBlEVoB8/visited';
const instagramUrl = 'https://www.instagram.com/cassbtravels/';
---
<ContentPageLayout title={title} description={description} subtitle={headerSubtitle} permalink="travel">
  <StatStrip>
    <StatBadge
      icon="fa-solid fa-earth-americas"
      value={travelStats.countries.toLocaleString()}
      label="countries"
      countUp
      countTo={travelStats.countries}
    />
    <StatBadge
      icon="fa-solid fa-umbrella-beach"
      value={travelStats.territories.toLocaleString()}
      label="territories"
      countUp
      countTo={travelStats.territories}
    />
    <StatBadge
      icon="fa-solid fa-map"
      value={travelStats.regions.toLocaleString()}
      label="regions"
      countUp
      countTo={travelStats.regions}
    />
    <StatBadge
      icon="fa-solid fa-city"
      value={travelStats.cities.toLocaleString()}
      label="cities"
      countUp
      countTo={travelStats.cities}
    />
    <StatBadge
      icon="fa-solid fa-landmark"
      value={travelStats.attractions.toLocaleString()}
      label="attractions"
      countUp
      countTo={travelStats.attractions}
    />
  </StatStrip>

  <section class="travel-map">
    <iframe
      src={skratchUrl}
      title="Skratch travel map of visited places"
      loading="lazy"
      allowfullscreen
    ></iframe>
    <p class="travel-map-note">
      <a href={skratchUrl} target="_blank" rel="noopener">Open full map ↗</a>
    </p>
  </section>

  <div class="oss-header travel-instagram">
    <a class="stat-badge" href={instagramUrl} target="_blank" rel="noopener">
      <span class="stat-icon"><i class="fa-brands fa-instagram"></i></span>
      <span class="stat-value">@cassbtravels</span>
      <span class="stat-label">follow our travels on Instagram</span>
    </a>
  </div>
</ContentPageLayout>

<style>
  .travel-map {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .travel-coverage {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .travel-map iframe {
    width: 100%;
    height: 560px;
    border: 0;
    border-radius: 12px;
    box-shadow: var(--shadow-lift);
  }

  .travel-map-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .travel-instagram {
    margin-top: 2.5rem;
  }

  @media (max-width: 640px) {
    .travel-map iframe {
      height: 420px;
    }
  }
</style>