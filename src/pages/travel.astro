---
import PageLayout from '../layouts/PageLayout.astro';
import { travelStats } from '../data/travel';

const title = 'Travel';
const description = 'Our holiday travels in stats and on the map';
const skratchUrl = 'https://share.skratch.world/N0cBlEVoB8/visited';
const instagramUrl = 'https://www.instagram.com/cassbtravels/';
---
<PageLayout title={title} description={description} cover="/covers/travel.svg">
  <header class="hero" style="background-image: url('/covers/travel.svg')">
    <div class="hero-content">
      <h1>{title}</h1>
      <p class="hero-sub">Our holiday travels, on the map and in numbers</p>
    </div>
  </header>

  <main class="main">
    <div class="container">
      <div class="oss-header">
        <p class="prose">
          {description}:
        </p>
        <div class="oss-badges">
          <span class="stat-badge">
            <i class="stat-icon fa-solid fa-earth-americas" aria-hidden="true"></i>
            <span class="stat-value" data-count-up data-count-to={travelStats.countries}>{travelStats.countries.toLocaleString()}</span>
            <span class="stat-label">countries</span>
          </span>
          <span class="stat-badge">
            <i class="stat-icon fa-solid fa-umbrella-beach" aria-hidden="true"></i>
            <span class="stat-value" data-count-up data-count-to={travelStats.territories}>{travelStats.territories.toLocaleString()}</span>
            <span class="stat-label">territories</span>
          </span>
          <span class="stat-badge">
            <i class="stat-icon fa-solid fa-map" aria-hidden="true"></i>
            <span class="stat-value" data-count-up data-count-to={travelStats.regions}>{travelStats.regions.toLocaleString()}</span>
            <span class="stat-label">regions</span>
          </span>
          <span class="stat-badge">
            <i class="stat-icon fa-solid fa-city" aria-hidden="true"></i>
            <span class="stat-value" data-count-up data-count-to={travelStats.cities}>{travelStats.cities.toLocaleString()}</span>
            <span class="stat-label">cities</span>
          </span>
          <span class="stat-badge">
            <i class="stat-icon fa-solid fa-landmark" aria-hidden="true"></i>
            <span class="stat-value" data-count-up data-count-to={travelStats.attractions}>{travelStats.attractions.toLocaleString()}</span>
            <span class="stat-label">attractions</span>
          </span>
        </div>
      </div>

      <section class="travel-map">
        <iframe
          src={skratchUrl}
          title="Skratch travel map of visited places"
          loading="lazy"
          allowfullscreen
        ></iframe>
        <p class="travel-map-note">
          <a href={skratchUrl} target="_blank" rel="noopener">Open full map ↗</a>
        </p>
      </section>

      <div class="oss-header travel-instagram">
        <a class="stat-badge" href={instagramUrl} target="_blank" rel="noopener">
          <span class="stat-icon"><i class="fa-brands fa-instagram"></i></span>
          <span class="stat-value">@cassbtravels</span>
          <span class="stat-label">follow our travels on Instagram</span>
        </a>
      </div>
    </div>
  </main>
</PageLayout>

<style>
  .travel-map {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .travel-coverage {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .travel-map iframe {
    width: 100%;
    height: 560px;
    border: 0;
    border-radius: 12px;
    box-shadow: var(--shadow-lift);
  }

  .travel-map-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .travel-instagram {
    margin-top: 2.5rem;
  }

  @media (max-width: 640px) {
    .travel-map iframe {
      height: 420px;
    }
  }
</style>