---
import PageLayout from '../layouts/PageLayout.astro';
import { cards } from '../data/homepage';

const title = 'Hi, I\'m Adam';
const subtitle = 'Distinguished Engineer // Chief Architect // Senior Executive (VP)';
---
<PageLayout title={title} description={subtitle}>
  <header class="home-hero">
    <img class="avatar" src="/avatar.png" alt="Adam Setch" />
    <h1>{title}</h1>
    <p class="hero-sub">{subtitle}</p>
  </header>

  <div class="container">
    <div class="card-grid">
      {
        cards.map((s) => {
          return (
            <a class="card" href={`/${s.permalink}`}>
              <div class="card-cover" style={`background-image: url('${s.cover}')`}></div>
              <div class="card-body">
                <div class="card-title">
                  <span class="card-icon">{s.icon}</span>
                  {s.title}
                </div>
                <p class="card-desc">{s.blurb}</p>
                <div class="card-meta">
                  <span class="card-link"> &rarr;</span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</PageLayout>
