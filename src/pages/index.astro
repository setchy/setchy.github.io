---
import PageLayout from '../layouts/PageLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { cards } from '../data/homepage';
import { heroStats } from '../data/hero-stats';
import { projects } from '../data/projects';
import { githubCache } from '../data/github-cache';

const title = 'Hi, I\'m Adam';
const subtitle = 'Distinguished Engineer · Chief Architect · Technology Advisor · OSS Maintainer';

const topLine = 'Distinguished Engineer · Chief Architect · Technology Advisor · OSS Maintainer';
const tagline =
  'I build engineering organizations, maintain open-source tools developers depend on, and grow communities that scale.';

const featuredKeys = ['gitify-app/gitify', 'setchy/atlassify', 'setchy/thoughtworks-tech-radar-volumes'];
const featured = projects
  .filter((p) => featuredKeys.includes(`${p.owner}/${p.repo}`))
  .map((p) => {
    const meta = githubCache[`${p.owner}/${p.repo}`] ?? null;
    return { ...p, meta };
  })
  .sort((a, b) => (b.meta?.stargazers_count ?? 0) - (a.meta?.stargazers_count ?? 0));

const stats = [
  { value: heroStats.stars.toLocaleString(), countTo: heroStats.stars, label: 'GitHub stars', href: '/open-source/' },
  {
    value: heroStats.projects.toLocaleString(),
    countTo: heroStats.projects,
    label: 'open-source projects',
    href: '/open-source/',
  },
  { value: heroStats.talks.toLocaleString(), countTo: heroStats.talks, label: 'talks & case studies', href: '/industry/' },
  {
    value: heroStats.countries.toLocaleString(),
    countTo: heroStats.countries,
    label: 'countries traveled',
    href: '/travel/',
  },
];
---
<PageLayout title={title} description={subtitle}>
  <header class="home-hero">
    <img class="avatar" src="/avatar.png" alt="" width="96" height="96" decoding="async" />
    <p class="hero-eyebrow">{topLine}</p>
    <h1>{title}</h1>
    <p class="hero-tagline">{tagline}</p>
    <ul class="hero-stats" aria-label="Highlights">
      {
        stats.map((s) => (
          <li>
            <a href={s.href}>
              <span class="hero-stat-value mono" data-count-up data-count-to={s.countTo}>{s.value}</span>
              <span class="hero-stat-label">{s.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </header>

  <div class="container">
    <section class="featured-section">
      <h2 class="featured-title">Featured open source</h2>
      <div class="featured-grid">
        {
          featured.map((p) => (
            <ProjectCard owner={p.owner} repo={p.repo} role={p.role} meta={p.meta} url={p.url} note={p.note} />
          ))
        }
      </div>
      <p class="featured-more">
        …and <a href="/open-source/">18 more projects and contributions in the Open Source section</a>.
      </p>
    </section>

    <section class="advisor-section">
      <h2 class="advisor-title">Technology advisor</h2>
      <p class="advisor-note">Open to advisory conversations with engineering leaders.</p>
      <a class="advisor-cta" href="https://linkedin.com/in/adamsetch" target="_blank" rel="noopener">
        Let's talk <span aria-hidden="true">&rarr;</span>
      </a>
    </section>

    <div class="card-grid">
      {
        cards.map((s) => {
          return (
            <a class="card" href={`/${s.permalink}`}>
              <div class="card-head">
                <span class="card-icon"><i class={s.icon} aria-hidden="true"></i></span>
                <span class="card-title">{s.title}</span>
              </div>
              <div class="card-body">
                <p class="card-desc">{s.blurb}</p>
                <div class="card-meta">
                  <span class="card-link"> &rarr;</span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</PageLayout>