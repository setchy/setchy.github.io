---
import PageLayout from '../layouts/PageLayout.astro';
const pages = [
  { label: 'About', href: '/about/' },
  { label: 'Open Source', href: '/open-source/' },
  { label: 'Industry', href: '/industry/' },
  { label: 'Radars', href: '/radars/' },
  { label: 'Library', href: '/library/' },
  { label: 'Travel', href: '/travel/' },
];
---
<PageLayout title="404 — Page not found" description="The requested page could not be found">
  <main class="main notfound">
    <p class="notfound-eyebrow mono">404</p>
    <h1>Page not found</h1>
    <p class="notfound-note">The page you're looking for doesn't exist, was moved, or never made it here. Let's get you back on track.</p>
    <img class="notfound-img" src="/this-is-fine.png" alt="This is fine" loading="lazy" />
    <p class="notfound-actions">
      <a class="stat-badge" href="/">
        <i class="fa-solid fa-house" aria-hidden="true"></i>
        <span class="stat-value">Back to home</span>
      </a>
      <span>or</span>
      {pages.slice(0, 4).map((p) => (
        <a class="stat-badge" href={p.href}>
          <span class="stat-label">{p.label}</span>
        </a>
      ))}
    </p>
  </main>
</PageLayout>