---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FilterLegend from '../components/FilterLegend.astro';
import StatStrip from '../components/StatStrip.astro';
import StatBadge from '../components/StatBadge.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, ROLE_LABELS, type Project, type ProjectRole } from '../data/projects';
import { githubCache, type GithubRepoMeta } from '../data/github-cache';
import { stats } from '../data/stats';
import { sectionIcon } from '../data/section-icons';
import { groupBy } from '../lib/grouping';
import { formatStars } from '../lib/format';
import { pageMeta } from '../data/page-meta';

interface ProjectCardData extends Project {
  meta: GithubRepoMeta | null;
  link: string;
  roleInfo: { label: string; icon: string };
}

const { title, description } = pageMeta['open-source'];

const cards: ProjectCardData[] = projects
  .map((p) => {
    const key = p.repo ? `${p.owner}/${p.repo}` : p.owner;
    const meta = key && githubCache[key] ? githubCache[key] : null;
    const link = p.url ?? `https://github.com/${p.owner}/${p.repo}`;
    return { ...p, meta, link, roleInfo: ROLE_LABELS[p.role] };
  })
  .sort((a, b) => {
    const aStars = a.meta?.stargazers_count ?? -1;
    const bStars = b.meta?.stargazers_count ?? -1;
    return bStars - aStars;
  });

const categoryOrder = [
  'Productivity Tooling',
  'DevSecOps Tooling',
  'Technology Radars',
  'API Frameworks',
  'Methodologies',
  'Travel',
  'Dining',
];
const groups = groupBy(cards, (card) => card.category, categoryOrder);
const countForRole = (role: ProjectRole) => cards.filter((c) => c.role === role).length;

const roleOptions = (['created', 'maintain', 'contribute'] as ProjectRole[]).map((role) => ({
  value: role,
  label: ROLE_LABELS[role].label,
  icon: ROLE_LABELS[role].icon,
  count: countForRole(role),
}));

/** Homepage shown in the card footer when present (e.g. org pages or meta homepage). */
const homepageOf = (c: ProjectCardData): string | undefined => {
  if (c.meta?.homepage) return c.meta.homepage.replace(/^https?:\/\//, '');
  if (!c.meta && c.url) return c.url.replace(/^https?:\/\//, '');
  return undefined;
};
---
<ContentPageLayout title={title} description={description} subtitle={description} permalink="open-source">
  <StatStrip>
    <StatBadge
      icon="fa-solid fa-user"
      href="https://github.com/setchy?tab=followers"
      value={stats.github.followers.toLocaleString()}
      label="followers"
      countUp
      countTo={stats.github.followers}
    />
    <StatBadge
      icon="fa-solid fa-chart-line"
      href="https://github.com/setchy"
      value={stats.github.contributions.toLocaleString()}
      label="contributions"
      countUp
      countTo={stats.github.contributions}
    />
    <StatBadge
      icon="fa-solid fa-keyboard"
      href="https://wakatime.com/@2b948ae2-4be1-4020-8a57-7de60b53fe1d"
      value={stats.wakatime.hours.toLocaleString()}
      label="hrs coded"
      countUp
      countTo={stats.wakatime.hours}
    />
    <a class="sponsor-btn" href="https://github.com/sponsors/setchy" target="_blank" rel="noopener">
      <i class="fa-solid fa-heart" aria-hidden="true"></i>
      Sponsor
    </a>
  </StatStrip>

  <FilterLegend group="role" options={roleOptions} total={cards.length} />

  {
    groups.map((group) => (
      <section class="project-section" data-filter-section="role">
        <SectionHeading title={group.key} icon={sectionIcon(group.key)} />
        <div class="project-grid">
          {group.items.map((c) => (
            <ProjectCard
              url={c.link}
              name={c.repo ? `${c.owner}/${c.repo}` : c.owner}
              description={c.meta?.description ?? c.note ?? ''}
              roleLabel={c.roleInfo.label}
              roleIcon={c.roleInfo.icon}
              stars={formatStars(c.meta?.stargazers_count ?? 0)}
              ownerAvatar={`https://github.com/${c.owner}.png?size=80`}
              language={c.meta?.language ?? undefined}
              homepage={homepageOf(c)}
              filterValue={c.role}
              filterCard="role"
            />
          ))}
        </div>
      </section>
    ))
  }
</ContentPageLayout>