---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FilterLegend from '../components/FilterLegend.astro';
import LibraryCard from '../components/LibraryCard.astro';
import { libraryItems, TYPE_LABELS, type LibraryType } from '../data/library';
import { sectionIcon } from '../data/section-icons';
import { groupBy } from '../lib/grouping';
import { pageMeta } from '../data/page-meta';

const { title, description } = pageMeta.library;

const topicOrder = [
  'Architecture',
  'APIs',
  'API',
  'Engineering',
  'Tech Orgs',
  'Product Management',
  'WoW',
  'Thought Leaders',
  'GraphQL',
  'Tech Leadership',
  'Identity',
  'Cloud',
  'Product Delivery',
  'Other',
];

const groups = groupBy(libraryItems, (item) => item.topic, topicOrder);

const countForType = (type: LibraryType) => libraryItems.filter((item) => item.type === type).length;

const filterOptions = (['blog', 'podcast', 'ebook'] as LibraryType[]).map((type) => ({
  value: type,
  label: TYPE_LABELS[type].label,
  icon: TYPE_LABELS[type].icon,
  count: countForType(type),
}));
---
<ContentPageLayout title={title} description={description} subtitle={description} permalink="library">
  <FilterLegend group="type" options={filterOptions} total={libraryItems.length} />

  {
    groups.map((group) => (
      <section class="project-section" data-filter-section="type">
        <SectionHeading title={group.key} icon={sectionIcon(group.key)} />
        <div class="library-grid">
          {group.items.map((item) => (
            <LibraryCard
              url={item.url}
              typeIcon={TYPE_LABELS[item.type].icon}
              title={item.title}
              filterValue={item.type}
              filterCard="type"
            />
          ))}
        </div>
      </section>
    ))
  }
</ContentPageLayout>