---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { pageMeta } from '../data/page-meta';

const sections = await getCollection('sections');

const { title, description } = pageMeta.tags;

const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const tagMap = new Map<string, CollectionEntry<'sections'>[]>();
for (const entry of sections) {
  for (const tag of entry.data.tags) {
    if (!tagMap.has(tag)) tagMap.set(tag, []);
    tagMap.get(tag)!.push(entry);
  }
}
const tags = [...tagMap.keys()].sort();
---
<ContentPageLayout title={title} description={description} permalink="tags" container={false} mainClass="prose tags-page">
  {
    tags.map((tag) => (
      <a class="tag" href={`#${tag}`}>
        #{tag} ({tagMap.get(tag)!.length})
      </a>
    ))
  }
  {
    tags.map((tag) => (
      <section>
        <h2 id={tag}>#{tag} ({tagMap.get(tag)!.length})</h2>
        <div class="post-list">
          {
            tagMap.get(tag)!.map((entry) => (
              <div class="tag-entry">
                <a href={`/${entry.data.permalink}`}>{entry.data.title}</a>
                <span class="entry-date">{dateFmt.format(entry.data.date)}</span>
              </div>
            ))
          }
        </div>
      </section>
    ))
  }
</ContentPageLayout>